<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory Condition="'$(Configuration)' == 'Release'">false</CopyOutputSymbolsToPublishDirectory>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RouterKely.Core/RouterKely.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="Ui/Assets/pico.classless-2.1.1.min.css"
      LogicalName="RouterKely.Ui.pico.classless-2.1.1.min.css" />
    <!-- Single source of truth for the first-start configuration file. -->
    <EmbeddedResource
      Include="../../config/router-kely.local.json.example"
      LogicalName="RouterKely.Configuration.default-configuration.json" />
  </ItemGroup>
</Project>
