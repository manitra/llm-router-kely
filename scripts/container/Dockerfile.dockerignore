# BuildKit applies this file because it sits next to Dockerfile. Patterns are
# relative to the build context root, which is the repository root.
# Keep the build context small and free of local secrets.
**/bin/
**/obj/
.git/
.github/
TestResults/
scripts/.tmp*
# Only the templates the build embeds are sent; local config, identity files and any
# statistics.persistenceDirectoryPath store stay out, whatever they are named.
config/*
!config/*.example
